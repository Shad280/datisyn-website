# SMTP Settings for Contact Form (server-side email)
# Use SendGrid, Mailgun, or any SMTP provider

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_FROM=hello@datisyn.com
CONTACT_RECEIVER=info@datisyn.com

# ========================================================================
# 🚂 RAILWAY DEPLOYMENT INSTRUCTIONS
# ========================================================================
#
# 1. Go to https://railway.app and create a new project
# 2. Connect your GitHub repository
# 3. Railway will auto-detect Next.js and deploy
# 4. Go to your project → "Variables" tab
# 5. Add each environment variable listed above
# 6. Railway will automatically redeploy
#
# ========================================================================
# 📧 RECOMMENDED SMTP PROVIDERS
# ========================================================================
#
# SendGrid (Free tier: 100 emails/day):
# - SMTP_HOST=smtp.sendgrid.net
# - SMTP_PORT=587
# - SMTP_USER=apikey
# - SMTP_PASS=your_sendgrid_api_key
#
# Mailgun (Free tier: 5,000 emails/month):
# - SMTP_HOST=smtp.mailgun.org
# - SMTP_PORT=587
# - SMTP_USER=postmaster@yourdomain.mailgun.org
# - SMTP_PASS=your_mailgun_password
#
# Gmail (For testing only - use App Password):
# - SMTP_HOST=smtp.gmail.com
# - SMTP_PORT=587
# - SMTP_USER=your.email@gmail.com
# - SMTP_PASS=your_gmail_app_password
#
# ========================================================================
# 🔒 SECURITY NOTES
# ========================================================================
#
# - Never commit .env.local to git (it's in .gitignore)
# - Use app-specific passwords, not your main account password
# - Railway encrypts all environment variables
# - Test your SMTP settings locally before deploying
